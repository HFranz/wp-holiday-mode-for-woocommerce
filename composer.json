{
    "name": "hfranz/wp-holiday-mode-for-woocommerce",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "wp-coding-standards/wpcs": "^3.3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Hfranz\\WpHolidayModeForWoocommerce\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Heinrich Franz",
            "email": "kontakt@sevmatic.com"
        }
    ],
    "scripts": {
        "make-pot": "wp i18n make-pot . languages/holiday-mode-woocommerce.pot --exclude=node_modules,vendor",
        "update-po": "wp i18n update-po languages/holiday-mode-woocommerce.pot languages/",
        "make-php": "wp i18n make-php languages/",
        "lint:php": "phpcs -p",
        "fix:php": "phpcbf -p",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}

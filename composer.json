{
    "name": "hfranz/wp-holiday-mode-for-woocommerce",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Hfranz\\WpHolidayModeForWoocommerce\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Heinrich Franz",
            "email": "kontakt@sevmatic.com"
        }
    ],
    "scripts": {
        "make-pot": "wp i18n make-pot . languages/wp-learnsuite-brevo-mailer.pot --exclude=node_modules",
        "make-php": "wp i18n make-php languages/",
        "lint:php": "phpcs -p --standard=WordPress --ignore=languages,vendor,node_modules .",
        "fix:php": "phpcbf -p --standard=WordPress --ignore=languages,vendor,node_modules .",
        "test": "phpunit"
    }
}

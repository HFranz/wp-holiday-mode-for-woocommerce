#. Plugin Name of the plugin
#: holiday-mode-woocommerce.php
msgid "Holiday Mode for WooCommerce"
msgstr "Holiday Mode for WooCommerce"

#. Plugin URI of the plugin
#: holiday-mode-woocommerce.php
msgid "https://wordpress.org/plugins/holiday-mode-for-woocommerce/"
msgstr "https://wordpress.org/plugins/holiday-mode-for-woocommerce/"

#. Description of the plugin
#: holiday-mode-woocommerce.php
msgid "Set your WooCommerce® shop to holiday or vacation mode with ease."
msgstr "Set your WooCommerce® shop to holiday or vacation mode with ease."

#. Author of the plugin
#: holiday-mode-woocommerce.php
msgid "Heinrich Franz"
msgstr "Heinrich Franz"

#. Author URI of the plugin
#: holiday-mode-woocommerce.php
msgid "https://sevmatic/?source=wordpress"
msgstr "https://sevmatic/?source=wordpress"

#: holiday-mode-woocommerce.php:93
msgid "Settings"
msgstr "Settings"

#: holiday-mode-woocommerce.php:351
msgid ""
"<strong>Holiday Mode for WooCommerce</strong> requires WooCommerce to be "
"installed and active."
msgstr ""
"<strong>Holiday Mode for WooCommerce</strong> requires WooCommerce to be "
"installed and active."

#: includes/class-hmfw-settings.php:25
msgid "Holiday Mode"
msgstr "Holiday Mode"

#: includes/class-hmfw-settings.php:41
msgid "Holiday Mode Settings"
msgstr "Holiday Mode Settings"

#: includes/class-hmfw-settings.php:44
msgid ""
"Set your WooCommerce® shop to holiday or vacation mode. Use a date range to "
"schedule closed time."
msgstr ""
"Set your WooCommerce® shop to holiday or vacation mode. Use a date range to "
"schedule closed time."

#: includes/class-hmfw-settings.php:47
msgid "Activate"
msgstr "Activate"

#: includes/class-hmfw-settings.php:48
msgid "Activate Holiday Mode"
msgstr "Activate Holiday Mode"

#: includes/class-hmfw-settings.php:54
msgid "Disable purchasing"
msgstr "Disable purchasing"

#: includes/class-hmfw-settings.php:55
msgid ""
"Make all products non-purchasable and remove the add-to-cart buttons while "
"Holiday Mode is active."
msgstr ""
"Make all products non-purchasable and remove the add-to-cart buttons while "
"Holiday Mode is active."

#: includes/class-hmfw-settings.php:61
msgid "Start of Holidays"
msgstr "Start of Holidays"

#: includes/class-hmfw-settings.php:62
msgid "Enter first day of Holidays here."
msgstr "Enter first day of Holidays here."

#: includes/class-hmfw-settings.php:67
msgid "End of Holidays"
msgstr "End of Holidays"

#: includes/class-hmfw-settings.php:68
msgid "Enter last day of Holidays here."
msgstr "Enter last day of Holidays here."

#: includes/class-hmfw-settings.php:73
msgid "Vacation message"
msgstr "Vacation message"

#: includes/class-hmfw-settings.php:74
msgid "Enter your Holiday message here."
msgstr "Enter your Holiday message here."

#: includes/class-hmfw-settings.php:78
msgid "I am on vacation."
msgstr "I am on vacation."

#: includes/class-hmfw-settings.php:123
msgid "Please enter a valid start date to activate Holiday Mode."
msgstr "Please enter a valid start date to activate Holiday Mode."

#: includes/class-hmfw-settings.php:127
msgid "Please enter a valid end date to activate Holiday Mode."
msgstr "Please enter a valid end date to activate Holiday Mode."

#: includes/class-hmfw-settings.php:129
msgid "The end date of Holiday Mode must not be before the start date."
msgstr "The end date of Holiday Mode must not be before the start date."

#: includes/class-hmfw-settings.php:135
msgid "Please enter a vacation message to activate Holiday Mode."
msgstr "Please enter a holiday message to activate Holiday Mode."


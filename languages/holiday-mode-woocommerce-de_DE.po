#. Plugin Name of the plugin
#: holiday-mode-woocommerce.php
msgid "Holiday Mode for WooCommerce"
msgstr "Urlaubsmodus für WooCommerce"

#. Plugin URI of the plugin
#: holiday-mode-woocommerce.php
msgid "https://wordpress.org/plugins/holiday-mode-for-woocommerce/"
msgstr "https://de.wordpress.org/plugins/holiday-mode-for-woocommerce/"

#. Description of the plugin
#: holiday-mode-woocommerce.php
msgid "Set your WooCommerce® shop to holiday or vacation mode with ease."
msgstr "Stelle deinen WooCommerce®-Shop ganz einfach auf Urlaubsmodus um."

#. Author of the plugin
#: holiday-mode-woocommerce.php
msgid "Heinrich Franz"
msgstr "Heinrich Franz"

#. Author URI of the plugin
#: holiday-mode-woocommerce.php
msgid "https://sevmatic/?source=wordpress"
msgstr "https://sevmatic/?source=wordpress"

#: holiday-mode-woocommerce.php:93
msgid "Settings"
msgstr "Einstellungen"

#: holiday-mode-woocommerce.php:356
msgid "<strong>Holiday Mode for WooCommerce</strong> requires WooCommerce to be installed and active."
msgstr "<strong>Der Urlaubsmodus für WooCommerce</strong> setzt voraus, dass WooCommerce installiert und aktiviert ist."

#: includes/class-hmfw-settings.php:25
msgid "Holiday Mode"
msgstr "Urlaubseinstellungen"

#: includes/class-hmfw-settings.php:42
msgid "Holiday Mode Settings"
msgstr "Urlaubseinstellungen"

#: includes/class-hmfw-settings.php:45
msgid "Set your WooCommerce® shop to holiday or vacation mode. Use a date range to schedule closed time."
msgstr "Stelle deinen WooCommerce-Shop auf Urlaubsmodus um. Lege mithilfe eines Datumsbereichs die Schließzeiten fest."

#: includes/class-hmfw-settings.php:48
msgid "Activate"
msgstr "Aktivieren"

#: includes/class-hmfw-settings.php:49
msgid "Activate Holiday Mode"
msgstr "Urlaubsmodus aktivieren"

#: includes/class-hmfw-settings.php:55
msgid "Disable purchasing"
msgstr "Bestellungen deaktivieren"

#: includes/class-hmfw-settings.php:56
msgid "Make all products non-purchasable and remove the add-to-cart buttons while Holiday Mode is active."
msgstr "Während des Urlaubsmodus können keine Produkte bestellt werden. Die „In den Warenkorb“-Schaltflächen werden ausgeblendet."

#: includes/class-hmfw-settings.php:62
msgid "Start of Holidays"
msgstr "Urlaubsbeginn"

#: includes/class-hmfw-settings.php:63
msgid "Enter first day of Holidays here."
msgstr "Trage hier den ersten Tag des Urlaubs ein."

#: includes/class-hmfw-settings.php:68
msgid "End of Holidays"
msgstr "Urlaubsende"

#: includes/class-hmfw-settings.php:69
msgid "Enter last day of Holidays here."
msgstr "Trage hier den letzten Tag des Urlaubs ein."

#: includes/class-hmfw-settings.php:74
msgid "Notice Color"
msgstr "Hinweisfarbe"

#: includes/class-hmfw-settings.php:75
msgid "Choose the color of the notice box shown for the vacation message."
msgstr "Wähle die Farbe des angezeigten Hinweisfeldes für die Abwesenheitsnachricht aus."

#: includes/class-hmfw-settings.php:81
msgid "Red"
msgstr "Rot"

#: includes/class-hmfw-settings.php:86
msgid "Blue"
msgstr "Blau"

#: includes/class-hmfw-settings.php:93
msgid "Vacation message"
msgstr "Urlaubsnachricht"

#: includes/class-hmfw-settings.php:94
msgid "Enter your Holiday message here."
msgstr "Trage hier die Urlaubsnachricht ein."

#: includes/class-hmfw-settings.php:98
msgid "I am on vacation."
msgstr "Ich bin im Urlaub."

#: includes/class-hmfw-settings.php:143
msgid "Please enter a valid start date to activate Holiday Mode."
msgstr "Bitte wähle ein gültiges Startdatum aus."

#: includes/class-hmfw-settings.php:147
msgid "Please enter a valid end date to activate Holiday Mode."
msgstr "Bitte wähle ein gültiges Enddatum aus."

#: includes/class-hmfw-settings.php:149
msgid "The end date of Holiday Mode must not be before the start date."
msgstr "Das Enddatum des Urlaubsmodus darf nicht vor dem Startdatum liegen."

#: includes/class-hmfw-settings.php:155
msgid "Please enter a vacation message to activate Holiday Mode."
msgstr "Trage hier dein Urlaubsnachricht ein."

#. translators: %s: five-star rating link
#: includes/class-hmfw-settings.php:238
#, php-format
msgid "If you like Holiday Mode for WooCommerce, please take a moment to leave us a %s rating. Thank you!"
msgstr "Wenn dir Urlaubsmodus für WooCommerce gefällt, nimm dir bitte einen Moment Zeit und bewerte das Plugin mit %s. Vielen Dank!"
